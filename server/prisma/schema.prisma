// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems     CartItem[]
  orders        Order[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// Refresh tokens are stored so they can be revoked (logout, rotation, compromise).
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  books Book[]

  @@map("categories")
}

model Book {
  id          String   @id @default(uuid())
  title       String
  author      String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  coverImage  String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([title])
  @@index([author])
  @@map("books")
}

model CartItem {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId   String
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  quantity Int    @default(1)

  @@unique([userId, bookId]) // one row per user/book pair; increment quantity instead of duplicating
  @@map("cart_items")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(10, 2)
  createdAt DateTime    @default(now())

  items OrderItem[]

  @@map("orders")
}

// Snapshot of price at purchase time — never trust live Book.price for historical orders.
model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId   String
  book     Book    @relation(fields: [bookId], references: [id])
  quantity Int
  price    Decimal @db.Decimal(10, 2) // price at time of purchase

  @@map("order_items")
}
